{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://borek.ai/schemas/followup_draft/v1.0",
  "title": "FollowupDraft",
  "description": "BT-33 / MS-32 draft resource shape. Renderer output only — sending is forbidden until review.",
  "type": "object",
  "additionalProperties": false,
  "required": ["subject", "body", "review_flags", "status"],
  "properties": {
    "subject": {
      "type": "string",
      "minLength": 1
    },
    "body": {
      "type": "string",
      "minLength": 1
    },
    "review_flags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "attachment_name": {
      "type": ["string", "null"],
      "description": "Referenced attachment when the protocol line is included."
    },
    "status": {
      "type": "string",
      "enum": ["draft", "reviewed", "sent"]
    }
  }
}
