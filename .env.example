# Borek AI Suite - local development (AT-50 will complete this file)
# Copy to .env and fill values before running docker compose.

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional legacy HS256 JWT secret (unit tests only). Real Supabase tokens use JWKS from SUPABASE_URL.
SUPABASE_JWT_SECRET=

# Redis / Celery
REDIS_URL=redis://redis:6379/0

# Database (Supabase Postgres)
# Option A: password + optional pooler host (recommended on networks without IPv6):
SUPABASE_DB_PASSWORD=
SUPABASE_DB_POOLER_HOST=aws-0-REGION.pooler.supabase.com
# Option B: paste full URI from Dashboard > Database > Connection string / pooling:
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.PROJECT_REF.supabase.co:5432/postgres

# Renderer service (Node.js PptxGenJS)
RENDERER_URL=http://renderer:4000

# LLM providers (server-side only)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# App
API_DATA_BACKEND=supabase
API_HOST=0.0.0.0
API_PORT=8000
WEB_PORT=3000
RENDERER_PORT=4000
