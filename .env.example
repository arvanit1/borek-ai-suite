# Borek AI Suite - local development (AT-50 will complete this file)
# Copy to .env and fill values before running docker compose.

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Redis / Celery
REDIS_URL=redis://redis:6379/0

# LLM providers (server-side only)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# App
API_HOST=0.0.0.0
API_PORT=8000
WEB_PORT=3000
RENDERER_PORT=4000
